---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { homePath } from "../../data/site";

const destination = homePath("zh");
---

<BaseLayout title="前往宋品豪主页" description="宋品豪的中文主页。" lang="zh" canonicalPath="/" noindex>
  <meta slot="head" http-equiv="refresh" content={`0;url=${destination}`} />
  <main id="main" class="message">
    <h1>中文主页已迁移</h1>
    <p>正在前往新的中文主页。</p>
    <p><a href={destination}>前往宋品豪主页</a></p>
  </main>
</BaseLayout>
