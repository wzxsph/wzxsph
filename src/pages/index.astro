---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomePage from "../components/HomePage.astro";
import { EMAIL, GITHUB, homeCopy, homePath } from "../data/site";

const copy = homeCopy.zh;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "宋品豪",
  alternateName: "Pinhao Song",
  jobTitle: "独立开发者",
  description: copy.description,
  url: new URL(homePath("zh"), Astro.site).toString(),
  email: `mailto:${EMAIL}`,
  sameAs: [GITHUB],
  knowsAbout: ["AI 应用", "原生软件", "计算机视觉"],
};
---

<BaseLayout title={copy.title} description={copy.description} lang="zh" canonicalPath="/" jsonLd={jsonLd}>
  <HomePage lang="zh" />
</BaseLayout>
