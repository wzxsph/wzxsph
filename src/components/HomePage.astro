---
import Header from "./Header.astro";
import { EMAIL, GITHUB, homeCopy, type Lang } from "../data/site";

interface Props { lang: Lang }

const { lang } = Astro.props;
const copy = homeCopy[lang];
---

<Header lang={lang} />

<main id="main" class="profile">
  <section class="introduction" aria-labelledby="name-heading">
    <h1 id="name-heading">{copy.name}</h1>
    <p>{copy.introduction}</p>
  </section>

  <section class="focus" aria-labelledby="focus-heading">
    <h2 id="focus-heading">{copy.focusHeading}</h2>
    <ul>{copy.focus.map((item) => <li>{item}</li>)}</ul>
  </section>

  <section class="contact" aria-labelledby="contact-heading">
    <h2 id="contact-heading">{copy.contactHeading}</h2>
    <div class="contact-links">
      <a href={`mailto:${EMAIL}`}>{copy.emailLabel}</a>
      <a href={GITHUB}>GitHub</a>
    </div>
  </section>
</main>

<footer class="site-footer">
  <p>© {new Date().getFullYear()} {copy.name}</p>
</footer>

<style>
  .profile,
  .site-footer {
    width: var(--shell);
    margin-inline: auto;
  }

  .profile {
    padding-block: clamp(4.5rem, 12vw, 8rem) 4.5rem;
  }

  .introduction h1 {
    font-size: clamp(2.9rem, 8vw, 4.5rem);
    font-weight: 520;
    line-height: 1.15;
    letter-spacing: -0.045em;
  }

  .introduction p {
    max-width: 36rem;
    margin-top: 1.75rem;
    color: var(--muted);
    font-size: clamp(1.1rem, 2.8vw, 1.35rem);
    line-height: 1.9;
    text-wrap: pretty;
  }

  .focus,
  .contact {
    margin-top: 3.25rem;
  }

  h2 {
    margin-bottom: 1rem;
    font-size: 0.9rem;
    font-weight: 550;
    line-height: 1.5;
  }

  .focus ul {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
    color: var(--muted);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }

  .contact-links a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .site-footer {
    margin-top: auto;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.78rem;
  }
</style>
